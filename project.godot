; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Scrap Titans"
config/version="0.1.0-m17"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.094, 0.078, 0.145, 1)
boot_splash/image="res://art/ui/splash.png"
boot_splash/use_filter=false
config/icon="res://art/ui/icon.png"

[autoload]

Data="*res://autoload/data.gd"
GameState="*res://autoload/game_state.gd"
Save="*res://autoload/save.gd"
Instrument="*res://autoload/instrument.gd"
Sound="*res://autoload/sound.gd"
Effects="*res://autoload/effects.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[gui]

theme/custom="res://ui/theme.tres"

[importer_defaults]

wav={
"compress/mode": 2,
"force/mono": true
}

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/lossless_compression/force_png=true
